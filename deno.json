{
  "fmt": {
    "semiColons": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "validate": "deno run --allow-read=manifests,scripts,generated scripts/validate-manifests.ts validate",
    "check-urls": "deno run --allow-read=manifests,scripts,generated --allow-net scripts/validate-manifests.ts check-urls",
    "test": "deno test --allow-read --allow-write scripts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.7",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "valibot": "jsr:@valibot/valibot@^1.2.0"
  }
}
